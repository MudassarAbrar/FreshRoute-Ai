# Copy to .env.local and fill in your Supabase project values.
# The Gemini API key never goes here — it is a server-side function secret.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud — Firebase Auth (Email/Password + Google Sign-in) + Firestore AI telemetry
# Get these from https://console.firebase.google.com → Project settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
